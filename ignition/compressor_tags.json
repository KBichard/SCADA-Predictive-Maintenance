      "dataType": "Boolean",
      "defaultValue": false,
      "eventScripts": [
        {
          "eventid": "alarmActive",
          "script": "\n    if alarmName != \"ML_Compressor_Fault\":\n        return\n\n    base = \"[default]Compressor_01/\"\n\n    readings = system.tag.readBlocking([\n        base + \"Replay_Timestamp\",\n        base + \"Motor_Current\",\n        base + \"Oil_Temperature\",\n        base + \"Reservoir_Pressure\",\n        base + \"Anomaly_Score\"\n    ])\n\n    body = \"\"\"\nSIMULATED INDUSTRIAL MAINTENANCE ALERT\n\nEquipment: Compressor 01\nPriority: CRITICAL\nStatus: Suspected equipment fault\n\nHistorical timestamp: %s\nMotor current: %.2f A\nOil temperature: %.2f C\nReservoir pressure: %.2f bar\nAnomaly score: %.4f\nAlarm threshold: 0.7028\n\nRecommended action:\nInspect compressor for potential air leakage\nor abnormal operating conditions.\n\nDetection method: Isolation Forest\n\nThis is a simulated notification.\nNo physical equipment is connected.\n\"\"\" % (\n        readings[0].value,\n        readings[1].value,\n        readings[2].value,\n        readings[3].value,\n        readings[4].value\n    )\n\n    system.net.sendEmail(\n        smtp=\"127.0.0.1:1025\",\n        fromAddr=\"scada@example.com\",\n        to=[\"maintenance@example.com\"],\n        subject=\"[SIMULATION] CRITICAL - Compressor 01\",\n        body=body,\n        priority=\"1\"\n    )\t"
        }
      ],
